    {
      "type": "object",
      "properties": {
        "apiVersion": {
          "const": "platform.example.com/v1alpha1"
        },
        "kind": {
          "const": "LLM"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,50}$"
            },
            "owner": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,50}$"
            }
          },
          "required": [
            "name",
            "owner"
          ],
          "additionalProperties": false
        },
        "spec": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[a-z0-9][a-z0-9/-]*[a-z0-9]$"
            },
            "policy_profile": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,50}$"
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "credential_env": {
              "type": "string",
              "pattern": "^AIOPS_[A-Z0-9_]+$"
            },
            "smoke": {
              "type": "object",
              "properties": {
                "prompt": {
                  "type": "string",
                  "minLength": 1
                },
                "stream": {
                  "type": "boolean"
                }
              },
              "required": [
                "prompt",
                "stream"
              ],
              "additionalProperties": false
            },
            "credential_header": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
            },
            "provider_options": {
              "type": "object"
            }
          },
          "required": [
            "path",
            "policy_profile",
            "provider",
            "model",
            "credential_env",
            "smoke",
            "credential_header",
            "provider_options"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "additionalProperties": false
    },
